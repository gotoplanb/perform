# Copy to .env and edit. .env is gitignored.
#
# Every value here has a working default — Perform boots with no .env at all.
# The file exists to document the knobs, not because anything is required.

# Bind address. Loopback by default and deliberately so: Perform owns the
# machine's speakers and screen and has no auth story yet. If you change host
# away from 127.0.0.1, set PERFORM_TOKEN in the same edit.
PERFORM_HOST=127.0.0.1
PERFORM_PORT=8770

# Optional shared secret. Unset means no auth, which is correct on loopback.
# Set it and every request needs `Authorization: Bearer <token>`. Generate with
# `openssl rand -hex 32`.
PERFORM_TOKEN=

# --- Asset library ---------------------------------------------------------

# Where packs are discovered at startup. A pack is a folder of media plus a
# pack.toml manifest; dropping a folder in here is the whole install. The repo
# ships no media — the built-in tones are synthesized numerically.
PERFORM_PACKS_DIR=./packs

# The warm cache: content-addressed normalized PCM, plus its SQLite index.
# Everything playable passes through here once, whether it came from a pack,
# from a path Wander handed over, or from `say`. Rebuildable — deleting it
# costs you the next warm, nothing more.
PERFORM_BLOBS_DIR=./blobs
PERFORM_LIBRARY_DB=./perform-library.sqlite

# Soft ceiling on *unpinned* cache entries, in MB. Pack assets are pinned and
# never evicted or counted. 0 disables eviction.
PERFORM_CACHE_MAX_MB=2048

# --- Audio device ----------------------------------------------------------

# The whole mix graph runs at this rate/width and ingest resamples to match, so
# the mixer never resamples inside the callback. Changing either invalidates
# every cached blob (the rate is part of the cache key).
PERFORM_SAMPLE_RATE=48000
PERFORM_CHANNELS=2

# Frames per mixer callback. 512 @ 48k is ~10.7ms: small enough that a stop is
# perceptually immediate, large enough that Python's per-block overhead stays
# under the deadline. Raise it if you hear crackle/underruns.
PERFORM_BLOCK_SIZE=512

# PortAudio output device name or index. Empty means the system default.
# The literal string "null" selects NullDevice, which runs the entire mix graph
# and throws the audio away — use it for headless runs. The test suite sets
# this itself and never touches your speakers.
PERFORM_AUDIO_DEVICE=

# --- The system voice ------------------------------------------------------

# macOS `say` voice. `say -v '?'` lists what is installed. Empty means the
# system default. An unknown name fails the boot rather than falling back —
# a silent fallback means two participants sound identical and the listener
# has no idea why.
PERFORM_SAY_VOICE=
PERFORM_SAY_RATE=0

# --- Buses -----------------------------------------------------------------

# Bus definitions, sink routing, and the duck matrix. Reload without a restart
# by sending SIGUSR1 (`make reload-buses`). Not SIGHUP — uvicorn steals that.
PERFORM_BUSES_CONFIG=./config/buses.yaml

# How long a bus may rest on an open-ended item before /status calls it
# stalled. Buses declared `resting_open_ended: true` (backdrop, ambience) are
# exempt — that is their steady state.
PERFORM_STALL_AFTER_S=30

# --- Telemetry -------------------------------------------------------------

# Points at Watchtower's Alloy collector, same as conduct and wander. The OTel
# dependency floors are pinned to match theirs so all three emit one dialect.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=perform
